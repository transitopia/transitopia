# Production settings for infra/compose.yml. Copy to infra/.env (gitignored) and fill in.
# apps/server/src/env.ts documents each variable.

POSTGRES_PASSWORD=

# Upstream API keys (V2-PLAN.md §4.5). Only the production server polls.
TRANSLINK_API_KEY=
AISSTREAM_API_KEY=

PUBLIC_URL=https://api.transitopia.org
SITE_URL=https://www.transitopia.org
ALLOWED_ORIGINS=https://www.transitopia.org,https://transitopia.org,https://*.transitopia-web.pages.dev,http://localhost:5173

# GitHub OAuth app for /admin (callback: https://api.transitopia.org/auth/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins that are admins.
ADMIN_GITHUB_LOGINS=

# Cloudflare R2, as an rclone remote named r2 (rclone reads RCLONE_CONFIG_<REMOTE>_<OPTION>), with
# the server's API token: Object Read & Write on transitopia-data and transitopia-archive only.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# Where rclone writes: the published transit data (data.transitopia.org) and the private archive
# (raw recordings, GTFS feeds, backups, snapshots). The tokens can't create or list buckets, so the
# server and backups pass --s3-no-check-bucket.
DATA_PUBLISH_REMOTE=r2:transitopia-data
ARCHIVE_REMOTE=r2:transitopia-archive
