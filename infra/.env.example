# Production settings for infra/compose.yml. Copy to infra/.env (gitignored) and fill in.
# apps/server/src/env.ts documents each variable.

POSTGRES_PASSWORD=

# Upstream API keys (V2-PLAN.md §4.5). Only the production server polls.
TRANSLINK_API_KEY=
AISSTREAM_API_KEY=

PUBLIC_URL=https://api.transitopia.org
SITE_URL=https://www.transitopia.org
ALLOWED_ORIGINS=https://www.transitopia.org,https://transitopia.org,https://*.transitopia-web.pages.dev,http://localhost:5173

# GitHub OAuth app for /admin (callback: https://api.transitopia.org/auth/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins that are admins.
ADMIN_GITHUB_LOGINS=

# rclone remotes (infra/rclone.conf): published transit data (data.transitopia.org, R2) and the
# private archive (raw recordings, GTFS feeds, backups, snapshots; FullHost object storage).
DATA_PUBLISH_REMOTE=transitopia-data-r2:transitopia-data
ARCHIVE_REMOTE=fullhost:transitopia-archive
