# rclone remote for the server and backups. Copy to infra/rclone.conf (gitignored) and fill in.

# Cloudflare R2, with an API token that can read and write two buckets only: transitopia-data
# (published transit data, behind data.transitopia.org) and transitopia-archive (private: backups,
# raw recordings, GTFS feeds, the developer snapshot). The endpoint is
# https://<account id>.r2.cloudflarestorage.com. The tokens can't create or list buckets, so the
# server passes --s3-no-check-bucket.
[r2]
type = s3
provider = Cloudflare
endpoint =
access_key_id =
secret_access_key =
