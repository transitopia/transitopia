# Production data locations. Local development uses the defaults in src/config.ts, which read
# pipeline output from var/ (served at /dev-data/ by vite.config.ts).

# Instead of using the pmtiles protocol to stream tiles from a giant .pmtiles file,
# in production we use the CDN at this URL which can serve individual tiles.
# See https://docs.protomaps.com/deploy/ for details on how this works.
VITE_BASEMAP_TILES=https://map-tiles.transitopia.org/protomaps-bc.json
VITE_CYCLING_MAP_TILES_CDN=https://map-tiles.transitopia.org/transitopia-cycling-british-columbia.json
# Fonts and sprites for the basemap, copied into the build by vite.config.ts.
VITE_BASEMAP_ASSETS=/basemap-assets/
# Published transit data (plans, movements, track network, dispatch patches), built and uploaded
# daily by the server (apps/server/src/jobs/data-build.ts).
VITE_TRANSIT_DATA=https://data.transitopia.org/
# The server (apps/server): live buses, SeaBus AIS, service changes, recorded
# history and live dispatch. Without it the site falls back to schedule estimates.
VITE_TRANSIT_API=https://api.transitopia.org/
